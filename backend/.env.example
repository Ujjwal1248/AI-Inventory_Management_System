PORT=5001
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gemini_inventory
DB_USER=postgres
DB_PASSWORD=your_password

# CORS
FRONTEND_URL=http://localhost:5173

# ─── Session & Cookie Security ───────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_strong_session_secret_here
COOKIE_SECRET=your_strong_cookie_secret_here

# ─── Google OAuth 2.0 ────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# See SYSTEM_MANUAL.md for full setup instructions
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
